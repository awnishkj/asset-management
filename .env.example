# Backend
PORT=5000
MONGODB_URI=mongodb://localhost:27017/assettrack
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# SMTP (for email delivery)
# For production set these to your SMTP provider's values.
# For Gmail, use your Gmail address and an App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM=your_gmail_address@gmail.com
SMTP_SECURE=false

# Frontend API URL (if needed)
REACT_APP_API_URL=http://localhost:5000/api
