# ── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/assettrack?retryWrites=true&w=majority

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here

# ── Email Provider ────────────────────────────────────
# OPTION 1 (recommended for Render Free): Resend HTTP API
# Sign up at https://resend.com — free tier: 3000 emails/month
# Set EMAIL_FROM to a verified sender (or use onboarding@resend.dev for testing)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=AssetTrack <no-reply@yourdomain.com>

# OPTION 2 (local dev / self-hosted): Gmail SMTP via App Password
# NOTE: Render Free blocks SMTP ports 25/465/587 — do NOT use SMTP on Render
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM=your@gmail.com

# ── Tunnel / Frontend URL ─────────────────────────────
FRONTEND_URL=https://your-frontend-tunnel-or-domain.com
